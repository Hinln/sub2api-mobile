{
  "expo": {
    "name": "Hub Vexlune",
    "slug": "hub-vexlune",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/vexlune-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/vexlune-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F5F9"
    },
    "ios": {
      "supportsTablet": false,
      "icon": "./assets/vexlune-icon.png",
      "bundleIdentifier": "com.vexlune.mobile",
      "buildNumber": "3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/vexlune-icon.png",
      "package": "com.vexlune.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F6F5F9",
        "foregroundImage": "./assets/vexlune-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/vexlune-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "允许 Hub Vexlune 使用 Face ID 解锁管理控制台。"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "允许 Hub Vexlune 使用 Face ID 解锁管理控制台。"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "router": {}
    },
    "updates": {
      "enabled": false
    },
    "scheme": "vexlunemobile"
  }
}
