diff --git a/frontend/src/views/public/MobileTurnstileView.vue b/frontend/src/views/public/MobileTurnstileView.vue
new file mode 100644
index 0000000..9c984da
--- /dev/null
+++ b/frontend/src/views/public/MobileTurnstileView.vue
@@ -0,0 +1,193 @@
+<template>
+  <main class="mobile-turnstile-page" aria-live="polite">
+    <section class="turnstile-card" aria-label="安全验证">
+      <img class="brand-mark" src="/logo.svg" alt="" aria-hidden="true">
+      <h1>安全验证</h1>
+      <p v-if="state === 'loading'">正在加载官方安全验证…</p>
+      <p v-else-if="state === 'ready' || state === 'interactive'">请完成下方安全验证</p>
+      <p v-else-if="state === 'success'">验证已完成</p>
+      <p v-else class="error-text">{{ errorMessage }}</p>
+      <div ref="containerRef" class="turnstile-container" :class="{ hidden: state === 'loading' || state === 'error' || state === 'unsupported' || state === 'disabled' }"></div>
+      <button v-if="state === 'error' || state === 'unsupported'" type="button" class="retry-button" @click="initialize">重新验证</button>
+    </section>
+  </main>
+</template>
+
+<script setup lang="ts">
+import { onBeforeUnmount, onMounted, ref } from 'vue'
+
+type Action = 'login' | 'register' | 'forgot_password'
+type State = 'loading' | 'ready' | 'interactive' | 'success' | 'error' | 'unsupported' | 'disabled'
+declare global {
+  interface Window {
+    ReactNativeWebView?: { postMessage: (message: string) => void }
+  }
+}
+
+const BRIDGE_VERSION = 1
+const MAX_ERROR_LENGTH = 128
+const state = ref<State>('loading')
+const errorMessage = ref('官方安全验证组件未加载，请检查网络后重试。')
+const containerRef = ref<HTMLElement | null>(null)
+let widgetId: string | undefined
+let scriptElement: HTMLScriptElement | undefined
+let context: { requestId: string; nonce: string; action: Action } | null = null
+let sentSuccess = false
+let disposed = false
+let generation = 0
+
+function post(type: string, fields: Record<string, unknown> = {}) {
+  if (disposed || !context || !window.ReactNativeWebView || typeof window.ReactNativeWebView.postMessage !== 'function') return
+  window.ReactNativeWebView.postMessage(JSON.stringify({
+    version: BRIDGE_VERSION,
+    type,
+    requestId: context.requestId,
+    nonce: context.nonce,
+    action: context.action,
+    ...fields,
+  }))
+}
+
+function readContext() {
+  const params = new URLSearchParams(window.location.hash.startsWith('#') ? window.location.hash.slice(1) : window.location.hash)
+  const requestId = params.get('requestId') || ''
+  const nonce = params.get('nonce') || ''
+  const action = params.get('action')
+  if (params.get('version') !== String(BRIDGE_VERSION) || !/^[A-Za-z0-9._~-]{8,128}$/.test(requestId) || !/^[A-Za-z0-9._~-]{8,128}$/.test(nonce) || !['login', 'register', 'forgot_password'].includes(action || '')) {
+    return null
+  }
+  return { requestId, nonce, action: action as Action }
+}
+
+function setError(message: string, errorCode = 'page_error') {
+  if (disposed) return
+  state.value = 'error'
+  errorMessage.value = message
+  post('error', { errorCode: errorCode.slice(0, MAX_ERROR_LENGTH) })
+}
+
+function loadSdk(): Promise<void> {
+  if (window.turnstile) return Promise.resolve()
+  if (scriptElement) {
+    return new Promise((resolve, reject) => {
+      scriptElement?.addEventListener('load', () => resolve(), { once: true })
+      scriptElement?.addEventListener('error', () => reject(new Error('sdk_load_failed')), { once: true })
+    })
+  }
+  return new Promise((resolve, reject) => {
+    const script = document.createElement('script')
+    script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit'
+    script.async = true
+    script.defer = true
+    script.onload = () => resolve()
+    script.onerror = () => {
+      scriptElement = undefined
+      reject(new Error('sdk_load_failed'))
+    }
+    scriptElement = script
+    document.head.appendChild(script)
+  })
+}
+
+async function initialize() {
+  disposed = false
+  const currentGeneration = ++generation
+  if (widgetId && window.turnstile) {
+    try { window.turnstile.remove(widgetId) } catch { /* provider cleanup is best effort */ }
+  }
+  widgetId = undefined
+  sentSuccess = false
+  state.value = 'loading'
+  errorMessage.value = '官方安全验证组件未加载，请检查网络后重试。'
+  context = readContext()
+  if (!context) {
+    state.value = 'unsupported'
+    errorMessage.value = '验证页面参数无效，请返回应用后重试。'
+    return
+  }
+  if (!window.ReactNativeWebView || typeof window.ReactNativeWebView.postMessage !== 'function') {
+    state.value = 'unsupported'
+    errorMessage.value = '当前环境不支持安全验证。'
+    post('unsupported', { errorCode: 'native_bridge_missing' })
+    return
+  }
+
+  try {
+    const response = await fetch('/api/v1/settings/public', { headers: { Accept: 'application/json' }, credentials: 'same-origin' })
+    if (disposed || currentGeneration !== generation) return
+    const payload = await response.json() as { data?: Record<string, unknown> } & Record<string, unknown>
+    const settings = (payload.data && typeof payload.data === 'object' ? payload.data : payload) as Record<string, unknown>
+    if (settings.turnstile_enabled === false) {
+      if (settings.aliyun_captcha_enabled === true || settings.tencent_captcha_enabled === true) {
+        setError('当前启用的安全验证供应商不受 APP 支持，请联系管理员。', 'provider_unsupported')
+      } else {
+        state.value = 'disabled'
+        post('disabled')
+      }
+      return
+    }
+    const siteKey = typeof settings.turnstile_site_key === 'string' ? settings.turnstile_site_key.trim() : ''
+    if (!response.ok || settings.turnstile_enabled !== true || !siteKey) {
+      setError('安全验证配置异常，请联系管理员。', 'config_invalid')
+      return
+    }
+    await loadSdk()
+    if (disposed || currentGeneration !== generation) return
+    if (!window.turnstile || !containerRef.value) throw new Error('sdk_unavailable')
+    const renderOptions = {
+      sitekey: siteKey,
+      action: context.action,
+      theme: 'light',
+      size: 'flexible',
+      callback: (token: unknown) => {
+        if (sentSuccess || typeof token !== 'string' || token.length < 20 || token.length > 2048 || token.trim() !== token) return
+        sentSuccess = true
+        state.value = 'success'
+        post('success', { token })
+      },
+      'before-interactive-callback': () => {
+        state.value = 'interactive'
+        post('before-interactive')
+      },
+      'after-interactive-callback': () => post('after-interactive'),
+      'expired-callback': () => {
+        sentSuccess = false
+        state.value = 'ready'
+        post('expired')
+      },
+      'error-callback': () => {
+        sentSuccess = false
+        setError('官方安全验证组件未加载，请检查网络后重试。', 'turnstile_error')
+      },
+    } as unknown as Parameters<NonNullable<typeof window.turnstile>['render']>[1]
+    widgetId = window.turnstile.render(containerRef.value, renderOptions)
+    state.value = 'ready'
+    post('ready')
+  } catch (error) {
+    if (disposed || currentGeneration !== generation) return
+    setError('官方安全验证组件未加载，请检查网络后重试。', error instanceof Error ? error.message : 'sdk_unavailable')
+  }
+}
+
+onMounted(() => { void initialize() })
+onBeforeUnmount(() => {
+  disposed = true
+  generation += 1
+  if (widgetId && window.turnstile) {
+    try { window.turnstile.remove(widgetId) } catch { /* provider cleanup is best effort */ }
+  }
+  widgetId = undefined
+})
+</script>
+
+<style scoped>
+.mobile-turnstile-page { min-height: 100vh; display: flex; align-items: center; justify-content: center; margin: 0; padding: 16px; background: #f8faff; color: #142452; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
+.turnstile-card { width: min(100%, 420px); min-height: 154px; box-sizing: border-box; padding: 20px; border: 1px solid #dce5f4; border-radius: 18px; background: #fff; box-shadow: 0 12px 30px rgba(74, 97, 148, .1); text-align: center; }
+.brand-mark { width: 30px; height: 30px; margin: 0 auto 8px; border-radius: 10px; background: #eef0ff; object-fit: contain; }
+h1 { margin: 0; font-size: 16px; font-weight: 800; }
+p { margin: 8px 0 12px; color: #7382a5; font-size: 13px; }
+.error-text { color: #c73d53; }
+.turnstile-container { min-height: 65px; display: flex; justify-content: center; align-items: center; }
+.turnstile-container.hidden { display: none; }
+.retry-button { border: 0; border-radius: 10px; padding: 9px 16px; background: #6d6cf4; color: #fff; font-weight: 700; }
+</style>
